<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ErrorReport>send</ErrorReport>
    <RootNamespace>Health.Direct.Policy.UI</RootNamespace>
    <AssemblyName>Health.Direct.Policy.UI</AssemblyName>
    <OutputType>WinExe</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\build\DirectProject.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>Health.Direct.Policy.UI.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\common\common.csproj" />
    <ProjectReference Include="..\policy\policy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Rx-Core" Version="2.2.2" />
    <PackageReference Include="Rx-Interfaces" Version="2.2.2" />
    <PackageReference Include="Rx-Linq" Version="2.2.2" />
    <PackageReference Include="Rx-Main" Version="2.2.2" />
    <PackageReference Include="Rx-PlatformServices" Version="2.2.2" />
    <PackageReference Include="Rx-WPF" Version="2.2.2" />
    <PackageReference Include="Rx-XAML" Version="2.2.2" />
  </ItemGroup>
</Project>